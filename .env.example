# Copy to .env.local for local development. Never commit real values.

# Supabase project for this environment (Project settings > API). Both are public by design:
# row-level security in the database decides what each visitor can read or change.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Database tests (npm run test:db): a PostgreSQL 16 server with PostGIS. Tests create
# and drop their own databases on it. See tests/db/README.md.
TEST_DATABASE_URL=postgres://postgres@localhost:54329/postgres
